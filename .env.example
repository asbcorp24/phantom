# PostgreSQL установлен непосредственно на сервере/ПК
DATABASE_URL=postgresql://phantom:change_me@127.0.0.1:5432/phantom

# Redis установлен непосредственно на сервере/ПК (при необходимости)
REDIS_URL=redis://127.0.0.1:6379

# Закрытое файловое хранилище.
# Для первого этапа можно использовать локальное хранилище,
# затем подключить S3-совместимый сервис.
STORAGE_DRIVER=local
STORAGE_PATH=./storage/private

JWT_SECRET=change_me_to_a_long_random_secret
NEXT_PUBLIC_API_URL=http://localhost:3001
